<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>$(DAYBOOK_APS_ENVIRONMENT)</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(DAYBOOK_ICLOUD_CONTAINER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>$(DAYBOOK_ICLOUD_CONTAINER)</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.local.daybook</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)local.daybook</string>
		<string>$(AppIdentifierPrefix)local.daybook.phone</string>
		<string>$(AppIdentifierPrefix)local.daybook.shared</string>
	</array>
</dict>
</plist>
