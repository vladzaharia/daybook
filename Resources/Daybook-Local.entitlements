<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ad hoc ("Sign to Run Locally") development builds: everything in Daybook.entitlements except iCloud,
     which macOS only grants through a provisioning profile. These builds report that iCloud isn't
     available and keep sync off (see docs/icloud-sync.md, "Development builds"). -->
<plist version="1.0"><dict>
<key>com.apple.security.device.audio-input</key><true/>
</dict></plist>
