<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Signed builds (Apple Development, Developer ID). Hardened runtime is on (ENABLE_HARDENED_RUNTIME);
     the app is not sandboxed. The iCloud keys need a provisioning profile with the iCloud capability (iCloud
     Documents and CloudKit) and this container; push needs the Push Notifications capability. Xcode adds
     com.apple.application-identifier and com.apple.developer.team-identifier from that profile when it signs.
     DAYBOOK_ICLOUD_CONTAINER and DAYBOOK_APS_ENVIRONMENT come from Apps/macOS/Config/Signing.xcconfig: push is
     `development` here, as Apple Development profiles grant it, and the Developer ID export re-signs it `production`.
     CloudKit carries the courier (docs/icloud-sync.md, "Courier (CloudKit)"); CKSyncEngine needs the push entitlement.
     keychain-access-groups: the app's own group first, the default for items stored without a group (the link's
     pairing keys, the sync device ID); then local.daybook.app's, where releases before the one bundle ID stored them, so
     they stay readable (reads look in every group listed; a write moves an item to the first); then the group the
     iPhone app also lists, where library and cloud keys live (docs/icloud-sync.md, "Encryption"). The profiles grant
     <team>.*.

     Daybook-Sandbox.entitlements is this file plus the App Sandbox's keys (docs/sandbox.md): change both together. -->
<plist version="1.0"><dict>
<key>com.apple.security.device.audio-input</key><true/>
<key>com.apple.developer.icloud-services</key><array><string>CloudDocuments</string><string>CloudKit</string></array>
<key>com.apple.developer.icloud-container-identifiers</key><array><string>$(DAYBOOK_ICLOUD_CONTAINER)</string></array>
<key>com.apple.developer.ubiquity-container-identifiers</key><array><string>$(DAYBOOK_ICLOUD_CONTAINER)</string></array>
<key>com.apple.developer.aps-environment</key><string>$(DAYBOOK_APS_ENVIRONMENT)</string>
<key>keychain-access-groups</key><array><string>$(AppIdentifierPrefix)local.daybook</string><string>$(AppIdentifierPrefix)local.daybook.app</string><string>$(AppIdentifierPrefix)local.daybook.shared</string></array>
</dict></plist>
