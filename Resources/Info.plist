<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>Daybook</string>
<key>CFBundleDisplayName</key><string>Daybook</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
<key>NSHighResolutionCapable</key><true/>
<key>NSBluetoothAlwaysUsageDescription</key><string>Daybook connects to your Soundcore Work to import its recordings.</string>
<key>NSMicrophoneUsageDescription</key><string>Daybook records your voice in the conversations you record.</string>
<key>NSAudioCaptureUsageDescription</key><string>Daybook records call audio so both sides of a conversation are transcribed.</string>
<key>NSSpeechRecognitionUsageDescription</key><string>Daybook shows live captions while it records.</string>
<key>NSScreenCaptureUsageDescription</key><string>Daybook records call audio. No screen video is saved.</string>
<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
<key>CFBundleIconFile</key><string>Daybook.icns</string>
<key>NSAccentColorName</key><string>AccentColor</string>
<key>NSLocalNetworkUsageDescription</key><string>Daybook finds your iPhone on this network to record together.</string>
<key>NSBonjourServices</key><array><string>_daybook-link._tcp</string></array>
<key>DaybookICloudContainerIdentifier</key><string>$(DAYBOOK_ICLOUD_CONTAINER)</string>
</dict></plist>
